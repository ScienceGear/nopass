# Frontend build-time variables (Vercel).
# Local dev uses the Vite proxy (/api -> localhost:3001) and does NOT need these.

# Public support contact shown in the footer and contact page.
VITE_SUPPORT_EMAIL="support@novabank.dev"
VITE_SUPPORT_PHONE="1800-NOVABANK"

# Production only: full URL of the deployed Express API, including /api.
# Set this in Vercel's Environment Variables; Vercel appends it to the request path
# (e.g. https://novabank-api.onrender.com/api/auth/register/status).
# VITE_API_BASE_URL="https://your-backend.onrender.com/api"
