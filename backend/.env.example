DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novabank?schema=public"
# Use an in-memory Redis-compatible store for local development. Docker Compose
# overrides this with redis://redis:6379 for the containerized stack.
REDIS_URL="memory://"
PORT=3001
JWT_SECRET="generate-256-bit-random-string-here"
JWT_REFRESH_SECRET="different-256-bit-random-string"
WEBAUTHN_RP_NAME="NovaBank"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:5173"
# Comma-separated extra browser origins allowed by CORS (e.g. your production domain)
CORS_ORIGINS=""
# SMTP delivery — leave EMAIL_PASS empty in dev to log codes to the console.
# Production: Resend (https://resend.com) SMTP — host smtp.resend.com, user "resend",
# pass = a Resend API key. The From address must be on your verified sending domain.
EMAIL_HOST="smtp.resend.com"
EMAIL_PORT=587
EMAIL_USER="resend"
EMAIL_PASS=""
EMAIL_FROM_NAME="NovaBank Security"
EMAIL_FROM_ADDRESS="noreply@updates.sciencegear.tech"
HIBP_API_KEY=""
NODE_ENV="development"
