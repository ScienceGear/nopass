// NovaBank  Prisma schema (single source of truth)
// PostgreSQL 15+ required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
name          String
  phone         String?
  phoneVerified Boolean  @default(false)
  phoneVerifiedAt DateTime?
  balance       Decimal  @default(500000) @db.Decimal(12, 2)
  emailVerified Boolean  @default(false) // gate: passkeys can only be registered after email verification
  onboardingStep String  @default("email_pending") // email_pending -> passkey_set -> complete
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  credentials            Credential[]
  trustedDevices         TrustedDevice[]
  sessions               Session[]
  loginHistory           LoginHistory[]
  transactions           Transaction[]
  keystrokeProfile       KeystrokeProfile?
  recoveryCodes          RecoveryCode[]
  emailVerificationToken EmailVerificationToken?
  imageChallengeSetups   ImageChallengeSetup[]
  securitySettings       UserSecuritySettings?
  pccpConfig             PccpConfig?
  pccpClickpoints        PccpClickpoint[]
  pccpBaselines          PccpBehaviorBaseline[]
  pccpLockout            PccpLockout?
}

model Credential {
  id          String   @id @default(uuid())
  userId      String
  credentialId String  @unique // base64url from WebAuthn
  publicKey   Bytes
  counter     Int      @default(0)
  deviceType  String // "platform" | "cross-platform"
  backedUp    Boolean  @default(false)
  transports  String[] // e.g., ["internal", "hybrid"]
  nickname    String   @default("Unknown Device")
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrustedDevice {
  id          String   @id @default(uuid())
  userId      String
  fingerprint String // hash of canvas+fonts+ua+screen
  deviceInfo  String // parsed UA string
  ipAddress   String
  location    String? // city, country
  isRevoked   Boolean  @default(false)
  lastSeen    DateTime @updatedAt
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  deviceInfo   String
  ipAddress    String
  location     String?
  riskScore    Int      @default(0)
  revoked      Boolean  @default(false)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id         String   @id @default(uuid())
  userId     String
  eventType  String // "login", "logout", "transfer", "alert", "step_up"
  deviceInfo String
  ipAddress  String
  location   String?
  riskScore  Int      @default(0)
  riskAction String // "allow", "step_up", "image_challenge", "block"
  details    String? // JSON string for extra context
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  recipient String
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  status    String // "pending", "completed", "blocked", "step_up_required"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KeystrokeProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  transitions String // JSON: { "a-b": { mean: 120, std: 30 }, ... }
  sampleCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String // argon2 hash of the code
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  code      String // plaintext 6-digit, or hash if paranoid
  purpose   String // "login_step_up", "recovery"
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model QrSession {
  id         String   @id @default(uuid())
  token      String   @unique
  requestSecretHash String
  userId     String?
  status     String // "pending", "approved", "denied", "expired"
  deviceInfo String?
  location   String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

/** Email verification tokens  one per user, single-use, hashed, 15-min TTL. */
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** Audit trail for image-sequence step-up challenges (click-in-region). */
model ImageChallengeSetup {
  id        String    @id @default(uuid())
  userId    String?
  sequence  String // JSON: [{ imageKey, regionId }]
  attempts  Int       @default(0)
  verified  Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** Phone (SMS) OTP codes  hashed, one-per-purpose, 10-min TTL. */
model PhoneOtp {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String // argon2 hash of the 6-digit code
  purpose   String // "signup" | "phone_change" | "verify" | "login_step_up" | "recover"
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, purpose])
}

/** Email alert preferences for the security settings page. */
model UserSecuritySettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  alertNewDevice       Boolean  @default(true)
  alertLargeTransfer   Boolean  @default(true)
  alertBlockedSignIn   Boolean  @default(true)
  alertProductUpdates  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** PCCP enrollment: the 3 fixed images selected for this user + setup state. */
model PccpConfig {
  id           String   @id @default(uuid())
  userId       String   @unique
  imageIds     String[] // exactly 3 image IDs from the pool of 5, e.g. ["pccp-1","pccp-3","pccp-5"]
  orderSeed    Int      // seed for the permutation function (deterministic shuffle across attempts)
  attemptIndex Int      @default(0) // rotated per login attempt so image order changes each time
  enrolled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** Stored click-points: one row per (userId, imageId). Hash prevents raw reconstruction. */
model PccpClickpoint {
  id               String   @id @default(uuid())
  userId           String
  imageId          String   // "pccp-1" .. "pccp-5"
  sequencePosition Int      // 0, 1, or 2  index in the user's 3-image set
  gridCellX        Int      // 0..20 (21x21 grid)
  gridCellY        Int      // 0..20
  salt             String   // random salt for this clickpoint
  hash             String   // argon2id hash of salt + gridCellX + gridCellY + imageId + sequencePosition
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, imageId])
}

/** Behavioral timing baseline per device class per sequence position. */
model PccpBehaviorBaseline {
  id                String   @id @default(uuid())
  userId            String
  deviceClass       String   // "desktop" | "mobile"
  sequencePosition  Int      // 0, 1, 2
  meanTimeToClick   Float
  stddevTimeToClick Float
  meanInterClick    Float
  stddevInterClick  Float
  sampleCount       Int      @default(0)
  recentTimeToClick Float[]  // rolling window, max 20 entries
  recentInterClick  Float[]  // rolling window, max 20 entries
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceClass, sequencePosition])
}

/** PCCP-specific lockout (does NOT lock the entire account, only PCCP method). */
model PccpLockout {
  id             String    @id @default(uuid())
  userId         String    @unique
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
