// NovaBank — Prisma schema (single source of truth)
// PostgreSQL 15+ required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  balance      Decimal  @default(100000) @db.Decimal(12, 2)
  passwordHash String? // argon2id, set only if the user opts into the password fallback
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  credentials      Credential[]
  trustedDevices   TrustedDevice[]
  sessions         Session[]
  loginHistory     LoginHistory[]
  transactions     Transaction[]
  keystrokeProfile KeystrokeProfile?
  recoveryCodes    RecoveryCode[]
}

model Credential {
  id          String   @id @default(uuid())
  userId      String
  credentialId String  @unique // base64url from WebAuthn
  publicKey   Bytes
  counter     Int      @default(0)
  deviceType  String // "platform" | "cross-platform"
  backedUp    Boolean  @default(false)
  transports  String[] // e.g., ["internal", "hybrid"]
  nickname    String   @default("Unknown Device")
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrustedDevice {
  id          String   @id @default(uuid())
  userId      String
  fingerprint String // hash of canvas+fonts+ua+screen
  deviceInfo  String // parsed UA string
  ipAddress   String
  location    String? // city, country
  lastSeen    DateTime @updatedAt
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  deviceInfo   String
  ipAddress    String
  location     String?
  riskScore    Int      @default(0)
  revoked      Boolean  @default(false)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id         String   @id @default(uuid())
  userId     String
  eventType  String // "login", "logout", "transfer", "alert", "step_up"
  deviceInfo String
  ipAddress  String
  location   String?
  riskScore  Int      @default(0)
  riskAction String // "allow", "step_up_email", "step_up_passkey", "block"
  details    String? // JSON string for extra context
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  recipient String
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  status    String // "pending", "completed", "blocked", "step_up_required"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KeystrokeProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  transitions String // JSON: { "a-b": { mean: 120, std: 30 }, ... }
  sampleCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String // argon2 hash of the code
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  code      String // plaintext 6-digit, or hash if paranoid
  purpose   String // "login_step_up", "recovery"
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model QrSession {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String?
  status     String // "pending", "approved", "denied", "expired"
  deviceInfo String?
  location   String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}
